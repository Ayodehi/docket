// Signing defaults for anyone building from source: ad hoc signed, no Apple team needed.
// To sign with your own team (a stable signature keeps Keychain access without a prompt after
// every build), create Config/Local.xcconfig, which git ignores, for example:
//
//   BUNDLE_ID_PREFIX = com.example
//   DEVELOPMENT_TEAM = ABCDE12345
//   CODE_SIGN_STYLE = Automatic
//   CODE_SIGN_IDENTITY = Apple Development

BUNDLE_ID_PREFIX = io.github.docket
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

#include? "Local.xcconfig"
